// Prisma schema — QA Platform
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PRODUCT_OWNER
  DEVELOPER
  TESTER
}

enum TicketType {
  EPIC
  USER_STORY
  FEATURE
  TASK
  BUG
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  IN_TESTING
  DONE
  BLOCKED
}

enum TestResult {
  OK
  KO
  SKIPPED
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs & Authentification
// ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  // Mot de passe hashé avec bcrypt (coût ≥ 12). JAMAIS en clair. [OWASP A02/A07]
  hashedPassword  String
  name            String
  role            Role     @default(DEVELOPER)
  // Taux horaire en centimes (évite les erreurs de virgule flottante)
  hourlyRateCents Int      @default(0)
  // Soft delete : non-null = utilisateur desactive (ne peut plus se connecter)
  // Permet de conserver l'historique des tickets/audits crees par cet utilisateur
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedTickets Ticket[]        @relation("Assignee")
  createdTickets  Ticket[]        @relation("Creator")
  timeEntries     TimeEntry[]
  testExecutions  TestExecution[]
  testRuns        TestRun[]
  auditLogs       AuditLog[]
  sessions        Session[]
  attachments     Attachment[]
  leaves          UserLeave[]

  @@index([role])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hash du token de session (le token brut n'est jamais stocké) [OWASP A02]
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Projet
// ─────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  key         String   @unique // ex: "PROJ" ou "PROJ-RUN-1"
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation de sous-projet : un RUN est rattaché à un projet parent.
  // Null = projet racine. Non-null = sous-projet (typiquement créé via upload de spec).
  parentProjectId String?
  parentProject   Project?  @relation("ProjectSubProjects", fields: [parentProjectId], references: [id], onDelete: Cascade)
  subProjects     Project[] @relation("ProjectSubProjects")

  tickets Ticket[]

  // Plan de capacité courant pour ce projet (1 plan max, écrasé à chaque clic)
  capacityPlan CapacityPlan?

  @@index([key])
  @@index([parentProjectId])
}

// ─────────────────────────────────────────────────────────────
// Ticket (Epic / Feature / US / Task / Bug)
// ─────────────────────────────────────────────────────────────

model Ticket {
  id          String       @id @default(cuid())
  key         String       @unique // ex: "PROJ-142"
  title       String
  description String?
  type        TicketType
  status      TicketStatus @default(BACKLOG)
  priority    Int          @default(3) // 1 (haut) .. 5 (bas)

  // Hiérarchie : adjacency list + path matérialisé pour roll-up rapide
  parentId String?
  parent   Ticket?  @relation("TicketHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Ticket[] @relation("TicketHierarchy")
  path     String   @default("/") // ex: "/epic-id/feature-id/"

  // Temps
  estimatedMinutes Int  @default(0) // estimation initiale (feuille) - immuable par convention
  loggedMinutes    Int  @default(0) // temps déjà loggé (feuille)
  // Reste à faire estimé par le développeur. NULL = pas encore ré-estimé,
  // dans ce cas on utilise max(estimatedMinutes - loggedMinutes, 0) par défaut.
  remainingMinutes Int? // saisie manuelle par l'assignee/PO au fil du ticket
  // Si false, la tâche est une "TODO" : elle ne compte PAS dans la somme
  // d'estimation/RAF/atterrissage du parent. Par défaut true (comportement classique).
  isEstimated     Boolean @default(true)
  // Horodatage du premier log dans le sous-arbre d'une Feature (snapshot du gel).
  // Null tant qu'aucun gel ne s'est produit. Permet de distinguer les Tasks
  // enfants créées avant vs après le gel pour le calcul du RAF.
  frozenAt DateTime?
  // Au moment du gel d'une Feature, on capture la "fraction propre" :
  // snapshot - somme(estim Tasks chiffrées au moment du gel).
  // C'est la part de l'estimation initiale qui n'est PAS déjà couverte par
  // des Tasks. Permet de calculer correctement le RAF Feature même quand
  // le RAF des Tasks est ajusté manuellement.
  // Null sauf pour les Features gelées.
  frozenSelfMinutes Int?
  // Les roll-ups (estimé total, loggé total, reste total, projection) sont
  // calculés via la vue SQL ticket_rollup

  // Planning (jours ouvrés)
  // startDate : date de début d'exécution prévue (saisie par l'utilisateur)
  // endDate : calculée automatiquement à partir de startDate + RAF restant,
  //          mais stockée en BDD pour performance + historique
  // Les deux sont null tant que la planification n'a pas commencé.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Kanban
  boardOrder Int @default(0)

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    User    @relation("Creator", fields: [creatorId], references: [id])

  testCases       TestCase[]
  testRuns        TestRun[]
  timeEntries     TimeEntry[]
  attachments     Attachment[]
  // Allocations de capacité (placement P1 sur le calendrier)
  capacityPlanItems CapacityPlanItem[]
  // Exécution de test qui a généré ce bug (si type = BUG issu d'un KO)
  sourceExecution TestExecution? @relation("BugFromKo")

  // ─── EPIC E04 - Versioning des specs (Module 1.1 + 1.2) ───
  // Identifiant fonctionnel STABLE de la Feature (ex: "F02.4"). Cle de doublon
  // pour l'import/synchronisation JSON. NE DOIT PAS etre modifie apres creation.
  // Null pour les types autres que FEATURE.
  idFeatureSource String?
  // Version du JSON de specifications qui a CREE le ticket (immuable). Ex: "retrospec-1"
  versionCreation String?
  // Version COURANTE des specifications. Mise a jour a chaque re-import si l'idFeatureSource matche.
  versionSpecsCourante String?
  // Pour les tickets enfants (Task/Bug/US) crees sous une Feature : copie de
  // la versionSpecsCourante de la Feature parente AU MOMENT de la creation.
  // Trace l'origine des specs ayant servi a creer le ticket. Immuable.
  versionSpecsOriginelle String?
  // Derniere version exportee (cahier de tests / specs) pour cette Feature.
  // Permet de calculer le compteur "Features non exportees dans la version actuelle".
  lastExportedAtVersion String?
  // Horodatage du dernier export
  lastExportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, boardOrder])
  @@index([parentId])
  @@index([assigneeId])
  @@index([type])
  @@index([path])
  @@index([projectId, idFeatureSource]) // recherche par cle fonctionnelle (anti-doublon import)
}

// ─────────────────────────────────────────────────────────────
// Temps passé
// ─────────────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  minutes     Int
  description String?
  loggedAt    DateTime @default(now())

  @@index([ticketId])
  @@index([userId, loggedAt])
}

// ─────────────────────────────────────────────────────────────
// Cas de test
// ─────────────────────────────────────────────────────────────

model TestCase {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  title         String
  preconditions String?
  steps         String // markdown
  expected      String // résultat attendu
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  executions TestExecution[]

  @@index([ticketId, order])
}

model TestRun {
  id         String    @id @default(cuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  testerId   String
  tester     User      @relation(fields: [testerId], references: [id])
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    String? // ex: "3 OK, 1 KO"

  executions TestExecution[]

  @@index([ticketId])
  @@index([testerId])
}

model TestExecution {
  id            String     @id @default(cuid())
  testRunId     String
  testRun       TestRun    @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId    String
  testCase      TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testerId      String
  tester        User       @relation(fields: [testerId], references: [id])
  result        TestResult
  // Obligatoire si result = KO (voir CHECK constraint dans la migration)
  comment       String?
  screenshotUrl String?
  executedAt    DateTime   @default(now())

  // Si un KO a généré un bug automatiquement, on garde le lien
  generatedBugId String?  @unique
  generatedBug   Ticket?  @relation("BugFromKo", fields: [generatedBugId], references: [id])

  @@index([testRunId])
  @@index([testCaseId, executedAt])
  @@index([testerId, executedAt])
}

// ─────────────────────────────────────────────────────────────
// Pièces jointes
// ─────────────────────────────────────────────────────────────

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  url        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  uploadedAt DateTime @default(now())

  @@index([ticketId])
}

// ─────────────────────────────────────────────────────────────
// Audit Log (traçabilité complète — [OWASP A09])
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // ex: "TEST_EXECUTION.KO", "BUG.AUTO_CREATED"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Gestion des disponibilités : jours fériés + congés
// ─────────────────────────────────────────────────────────────

// Jours fériés globaux (toutes équipes confondues).
// Gérés par ADMIN/PO dans l'interface admin.
// La date est stockée en UTC pour éviter les surprises de fuseau horaire.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  label     String // ex: "Jour de l'an", "1er mai"
  createdAt DateTime @default(now())

  @@unique([date]) // une seule entrée par date
  @@index([date])
}

// Congés individuels d'un utilisateur.
// Chaque ligne représente une plage continue [startDate, endDate] inclusive.
// Le champ label est optionnel (ex: "Vacances été").
model UserLeave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String?
  createdAt DateTime @default(now())

  @@index([userId, startDate])
  @@index([userId, endDate])
}

// ─────────────────────────────────────────────────────────────
// Capacity Planning : placement automatique des tickets P1
// ─────────────────────────────────────────────────────────────

// Plan de capacité courant pour un projet. Un seul plan actif par projet
// (écrasé à chaque clic "Placement automatique").
model CapacityPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Date de génération du plan
  generatedAt   DateTime @default(now())
  // Utilisateur qui a déclenché la génération
  generatedById String
  // Date de fin projetée (= weekEnd de la dernière semaine utilisée)
  projectedEndDate DateTime? @db.Date
  // Minutes P1 qui n'ont pas pu être placées sur l'horizon
  leftoverMinutes  Int      @default(0)
  // Nombre de semaines projetées lors du calcul
  weeksCount       Int      @default(12)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CapacityPlanItem[]
}

// Allocation d'un ticket sur une semaine donnée du plan.
// Un même ticket peut être réparti sur plusieurs semaines (allocations multiples).
model CapacityPlanItem {
  id            String   @id @default(cuid())
  planId        String
  plan          CapacityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Le lundi de la semaine où une partie du ticket est planifiée
  weekStart     DateTime @db.Date
  // Nombre de jours alloués sur cette semaine pour ce ticket (en minutes pour précision)
  allocatedMinutes Int
  // Position dans l'ordre de placement (P1 par ordre de création)
  position      Int
  createdAt     DateTime @default(now())

  @@index([planId, weekStart])
  @@index([ticketId])
}

