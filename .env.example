# ─────────────────────────────────────────────────────────────
# Variables d'environnement — copier vers .env et remplir
# NE JAMAIS committer de vraies valeurs dans ce fichier
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL 16+
DATABASE_URL="postgresql://user:password@localhost:5432/qa_platform?schema=public"

# NextAuth — secret pour signer les sessions (générer avec: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_32_BYTE_BASE64_STRING"
AUTH_URL="http://localhost:3000"

# Stockage S3 / R2 pour les screenshots (upload via URL signée)
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_BUCKET="qa-platform-attachments"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_REGION="auto"

# Temps réel (optionnel — Pusher Channels)
# PUSHER_APP_ID=""
# PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER="eu"

# Environnement Node
NODE_ENV="development"
