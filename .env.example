# ─────────────────────────────────────────────────────────────
# Variables d'environnement — copier vers .env et remplir
# NE JAMAIS committer de vraies valeurs dans ce fichier
# ─────────────────────────────────────────────────────────────

# ============================================================
# OBLIGATOIRES (production et dev)
# ============================================================

# Base de donnees PostgreSQL 16+ (Neon en prod, Postgres local en dev)
# Format Neon : postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/qa_platform?schema=public"

# Secret pour signer les sessions (generer avec: openssl rand -base64 32)
# Doit faire au moins 32 caracteres aleatoires
AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_32_BYTE_BASE64_STRING"

# ============================================================
# CREATION DU COMPTE ADMIN INITIAL (seed)
# Utilisees uniquement par `npm run db:seed` la premiere fois
# ============================================================

# Email du compte ADMIN qui sera cree par le seed
SEED_ADMIN_EMAIL="admin@example.com"

# Mot de passe du compte ADMIN (au moins 8 caracteres)
SEED_ADMIN_PASSWORD="changeme-please-8chars-min"

# Nom affiche pour le compte ADMIN
SEED_ADMIN_NAME="Administrateur"

# ============================================================
# OPTIONNELLES — Stockage S3/R2 pour les screenshots de bugs
# Si non remplies, l'upload de screenshots sera desactive
# ============================================================

# S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
# S3_BUCKET="qa-platform-attachments"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"
# S3_REGION="auto"

# ============================================================
# OPTIONNELLES — Pusher pour notifications temps reel
# ============================================================

# PUSHER_APP_ID=""
# PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER="eu"

# ============================================================
# Variables auto-injectees (ne pas remplir manuellement)
# ============================================================

# AUTH_URL : URL publique de l'app
#   En dev : http://localhost:3000
#   En Vercel : https://${VERCEL_URL} (auto-detectee)
AUTH_URL="http://localhost:3000"

# NODE_ENV : "development" en dev, "production" en prod
NODE_ENV="development"
